---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { withBase } from "@/lib/utils/publicUrl";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

const entry = (await getEntry("frAbout", "-index")) as CollectionEntry<"frAbout">;
const enEntry = await getEntry("enAbout", "-index");
const { Content } = await render(entry);
const { title, subtitle, meta_title } = entry.data;
const image = enEntry?.data.image ?? entry.data.image;
const imageUrl = withBase(image);
const service_intro = entry.data.service_intro;
const what_i_do = entry.data.what_i_do;
const locale = (
  Astro.currentLocale ?? (Astro.url.pathname.startsWith("/fr") ? "fr" : "en")
) as "en" | "fr";
const contactHref = getRelativeLocaleUrl(locale, "/contact");
---

<Base title={title} meta_title={meta_title} image={image}>

  <!-- Box 1: Service intro (general) -->
  {service_intro && (
    <section class="section">
      <div class="container">
        <div class="rounded-lg p-8" style="background-color: #b9deea;">
          <div class="row md:gx-8 items-center">
            <div class="col">
              <h2 class="h3 mb-6">{service_intro.title}</h2>
              <p class="content">{service_intro.description}</p>
            </div>
            {service_intro.image && (
              <div class="col-auto">
                <img
                  src={service_intro.image}
                  alt={service_intro.title}
                  class="rounded-lg object-cover"
                  style="width: 260px; height: 340px;"
                />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Box 2: About the person -->
  <section class="section pt-0">
    <div class="container">
      <div class="rounded-lg p-8" style="border: 2px solid #b9deea;">
        <div class="row md:gx-8 items-center">
          <div class="sm:col-7 md:col-8">
            <h2 set:html={markdownify(title)} class="h3 mb-1" />
            {subtitle && <p class="text-lg font-normal text-text mb-6">{subtitle}</p>}
            <div class="content mb-6">
              <Content />
            </div>
            <a href={contactHref} class="btn btn-primary text-white py-2">Me contacter</a>
          </div>
          <div class="sm:col-5 md:col-4">
            {imageUrl && (
              <div class="img-cover">
                <Image
                  src={imageUrl}
                  width={295}
                  height={395}
                  alt={title}
                  class="rounded-lg w-full"
                />
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Box 3: What I do (service list) -->
  <section class="section pt-0">
    <div class="container-xl">
      <div class="rounded-lg p-8" style="background-color: #f5f5f5;">
        <h2 class="page-heading mb-4">{what_i_do.title}</h2>
        {what_i_do.subtitle && <p class="text-center mb-10">{what_i_do.subtitle}</p>}
        <div class="row gy-6">
          {what_i_do.items.map((item: any) => (
            <div class="md:col-6">
              <div class="row gx-4 items-center">
                <div class="col">
                  <h4 class="text-dark font-weight-700 mb-2">{item.title}</h4>
                  {item.subtitle && <p class="text-sm font-semibold mb-2">{item.subtitle}</p>}
                  <p class="mb-3">{item.description}</p>
                  {item.further_reading && (
                    <a href={getRelativeLocaleUrl(locale, `/${item.further_reading}`)} class="text-primary text-sm font-semibold hover:underline">
                      En savoir plus →
                    </a>
                  )}
                </div>
                {item.image && (
                  <div class="col-auto">
                    <img src={item.image} alt={item.title} class="rounded-lg object-cover" style="width: 140px; height: 140px;" />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Base>
