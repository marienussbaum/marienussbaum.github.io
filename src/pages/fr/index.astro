---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { withBase } from "@/lib/utils/publicUrl";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

const entry = (await getEntry("frAbout", "-index")) as CollectionEntry<"frAbout">;
const enEntry = await getEntry("enAbout", "-index");
const { Content } = await render(entry);
const { title, meta_title, what_i_do } = entry.data;
const image = enEntry?.data.image ?? entry.data.image;
const imageUrl = withBase(image);
const locale = (
  Astro.currentLocale ?? (Astro.url.pathname.startsWith("/fr") ? "fr" : "en")
) as "en" | "fr";
const contactHref = getRelativeLocaleUrl(locale, "/contact");
---

<Base title={title} meta_title={meta_title} image={image}>
  <section class="section">
    <div class="container">
      <div class="row md:gx-4">
        <div class="sm:col-7 md:col-8">
          <div class="rounded-lg p-8" style="background-color: #b9deea;">
            <h1 set:html={markdownify(title)} class="h3 mb-8" />
            <div class="content"><Content /></div>
            <a href={contactHref} class="btn btn-primary text-white py-2">Me contacter</a>
          </div>
        </div>
        <div class="sm:col-5 md:col-4">
          {imageUrl && (
            <div class="img-cover mb-8">
              <Image
                src={imageUrl}
                width={295}
                height={395}
                alt={title}
                class="rounded-lg w-full"
              />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
  <section class="section pt-0">
    <div class="container-xl">
      <h3 class="page-heading mb-4">{what_i_do.title}</h3>
      {what_i_do.subtitle && <p class="text-center text-light mb-12">{what_i_do.subtitle}</p>}
      <div class="row gy-4 text-center">
        {what_i_do.items.map((item: any) => (
          <div class="lg:col-3 md:col-6">
            {item.image && (
              <div class="mb-4">
                <img src={item.image} alt={item.title} class="rounded-lg w-full object-cover" style="height: 180px;" />
              </div>
            )}
            <h4 class="text-dark font-weight-700 mb-3">{item.title}</h4>
            {item.subtitle && <p class="text-sm font-semibold mb-2">{item.subtitle}</p>}
            <p class="mb-3">{item.description}</p>
            {item.further_reading && (
              <a href={getRelativeLocaleUrl(locale, `/${item.further_reading}`)} class="text-primary text-sm font-semibold hover:underline">
                En savoir plus →
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
