---
import '../styles/global.css';
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page introuvable — Marie Nussbaum</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="haut" style="min-height:100vh;display:flex;align-items:center">
    <div class="wrap" style="text-align:center;padding:60px 32px">
      <span class="caps" style="color:var(--laiton-d)">404</span>
      <h1 style="font-size:clamp(30px,4vw,44px);margin:18px 0 14px">Cette page n’existe pas — ou plus.</h1>
      <p style="color:var(--soft);max-width:52ch;margin:0 auto">This page does not exist — or no longer does.
         Le site a été réorganisé récemment&nbsp;; le texte que vous cherchez est sans doute à portée de main.</p>
      <p style="margin-top:32px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn" href="/fr/">Accueil</a>
        <a class="btn ligne" href="/fr/blog/">Carnets cliniques</a>
        <a class="btn ligne" href="/en/">English</a>
      </p>
    </div>
  </div>
</body>
</html>
