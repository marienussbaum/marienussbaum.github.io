---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { FaAddressCard, FaEnvelope, FaPhoneAlt } from "react-icons/fa";

const entry = (await getEntry(
  "enContact",
  "-index"
)) as CollectionEntry<"enContact">;
const { address, email, phone, booking_link } = config.contactinfo;
const { title, description, meta_title, image } = entry.data;
const emailMarkdown = email ? `[${email}](mailto:${email})` : "";
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section">
    <div class="container">
      <h1 set:html={markdownify(title)} class="h2 page-heading" />
      <div class="row gy-8 items-start">
        <div class="sm:col-5 md:col-4">
          <p class="mb-8 text-2xl font-bold text-text-dark">Contact Info</p>
          <ul class="flex flex-col space-y-8">
            <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaAddressCard className="mr-3 text-primary" />
                <p class="font-semibold">Address</p>
              </div>
              <p set:html={markdownify(address)} class="mt-2 leading-5 pl-8" />
            </li>
            <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaEnvelope className="mr-3 text-primary" />
                <p class="font-semibold">Email</p>
              </div>
              <p
                set:html={markdownify(emailMarkdown)}
                class="mt-2 leading-5 pl-8 content"
              />
            </li>
            {phone && (
            <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaPhoneAlt className="mr-3 text-primary" />
                <p class="font-semibold">Phone</p>
              </div>
              <p class="mt-2 leading-5 pl-8">{phone}</p>
            </li>
            )}
            {booking_link && (
            <li>
              <a
                href={booking_link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary mt-2 inline-block"
              >Book an appointment</a>
            </li>
            )}
          </ul>
        </div>
        <div class="sm:col-7 md:col-8">
          <iframe
            src="https://maps.google.com/maps?q=26+Boulevard+Raspail+75007+Paris+France&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="420"
            style="border: 0; border-radius: 0.5rem;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>
