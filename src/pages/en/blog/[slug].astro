---
import { getCollection } from 'astro:content';
import Article from '../../../components/Article.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const allPosts = (await getCollection('blog', (p) => p.data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Article post={post} lang="en" allPosts={allPosts} />
