---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { withBase } from "@/lib/utils/publicUrl";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"enPosts" | "frPosts">[];
  className?: string;
  fluid?: boolean;
};

const { className, posts, fluid } = Astro.props;

const locale = (
  Astro.currentLocale ?? (Astro.url.pathname.startsWith("/fr") ? "fr" : "en")
) as "en" | "fr";
const authors = await getSinglePage(locale === "fr" ? "frAuthors" : "enAuthors");

const blogHref = (id: string) => getRelativeLocaleUrl(locale, `/blog/${id}`);
const authorHref = (slug: string) =>
  getRelativeLocaleUrl(locale, `/authors/${slug}`);
const categoryHref = (slug: string) =>
  getRelativeLocaleUrl(locale, `/categories/${slug}`);
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => (
      <div class="col-12">
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-5 items-start">
          {post.data.image && (
            <a
              href={blogHref(post.id)}
              class="rounded-lg block hover:text-primary overflow-hidden group shrink-0 w-full sm:w-auto"
            >
              <Image
                class="group-hover:scale-[1.03] transition duration-300 object-cover w-full h-40 sm:w-[160px] sm:h-[120px]"
                src={withBase(post.data.image)}
                alt={post.data.title}
                width={160}
                height={120}
              />
            </a>
          )}
          <div class="flex-1">
            <ul class="mb-3 flex flex-wrap items-center text-text">
              <li class="mr-5">
                {authors
                  .filter((author) =>
                    post.data.authors
                      .map((author) => slugify(author))
                      .includes(slugify(author.data.title))
                  )
                  .map((author) => (
                    <a
                      href={authorHref(slugify(author.data.title))}
                      class="flex items-center hover:text-primary font-medium"
                    >
                      {author.data.image && (
                        <Image
                          src={withBase(author.data.image)}
                          alt={author.data.title}
                          height={50}
                          width={50}
                          class="mr-2 h-6 w-6 rounded-full"
                        />
                      )}
                      <span>{author.data.title}</span>
                    </a>
                  ))}
              </li>
              {post.data.date && (
                <li class="mr-5 flex items-center flex-wrap font-medium">
                  <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
                  {dateFormat(post.data.date)}
                </li>
              )}
              <li class="mr-5 flex items-center flex-wrap">
                <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />
                <ul>
                  {post.data.categories.map((category, i: number) => (
                    <li class="inline-block">
                      <a
                        href={categoryHref(slugify(category))}
                        class="mr-2 hover:text-primary font-medium"
                      >
                        {humanize(category)}
                        {i !== post.data.categories.length - 1 && ","}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            </ul>
            <h3 class="mb-2">
              <a
                href={blogHref(post.id)}
                class="block hover:text-primary transition duration-300"
              >
                {post.data.title}
              </a>
            </h3>
            <p class="text-text line-clamp-2">{plainify(post.body ?? "")}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>
