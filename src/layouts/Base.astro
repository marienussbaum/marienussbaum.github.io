---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  hreflangSlug?: string;
  /** Override hreflang hrefs when the slug differs between locales. */
  hreflangPaths?: { en: string; fr: string };
}

// destructure frontmatters
const { title, meta_title, description, image, noindex, canonical, ogType, hreflangSlug, hreflangPaths } =
  Astro.props;

const locale = (
  Astro.currentLocale ?? (Astro.url.pathname.startsWith("/fr") ? "fr" : "en")
) as "en" | "fr";

const brandSuffix: Record<"en" | "fr", string> = {
  en: "Marie Nussbaum – Psychologist in Marseille",
  fr: "Marie Nussbaum – Psychologue à Marseille",
};

const pageTitle = meta_title
  ? plainify(meta_title)
  : title
    ? `${plainify(title)} | ${brandSuffix[locale]}`
    : brandSuffix[locale];

const siteDescription =
  typeof config.metadata.meta_description === "string"
    ? config.metadata.meta_description
    : (config.metadata.meta_description as Record<string, string>)[locale];

const metaDesc = plainify(description ?? siteDescription);

const canonicalUrl = new URL(Astro.url.pathname, config.site.base_url).href;

const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|fr)/, "") || "/";
const effectivePath = hreflangSlug ?? pathWithoutLocale;
const enPath = hreflangPaths?.en ?? effectivePath;
const frPath = hreflangPaths?.fr ?? effectivePath;
const enHref = new URL(`/en${enPath === "/" ? "" : enPath}`, config.site.base_url).href;
const frHref = new URL(`/fr${frPath === "/" ? "" : frPath}`, config.site.base_url).href;

const linkedinUrl =
  social.main.find((s: { name: string; link: string }) => s.name === "linkedin")?.link ?? "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Psychologist"],
  name: config.site.logo_text,
  description: siteDescription,
  url: config.site.base_url,
  telephone: config.contactinfo.phone,
  email: config.contactinfo.email,
  image: `${config.site.base_url}${config.metadata.meta_image}`,
  address: {
    "@type": "PostalAddress",
    streetAddress: "19 Boulevard Rabatau",
    addressLocality: "Marseille",
    postalCode: "13008",
    addressCountry: "FR",
  },
  sameAs: [linkedinUrl],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={canonical ?? canonicalUrl} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={metaDesc} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:site_name" content="Marie Nussbaum" />

    <!-- twitter tags -->
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${image ? image : config.metadata.meta_image}`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${image ? image : config.metadata.meta_image}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- JSON-LD LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
