---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, DOCTOLIB, LINKEDIN } from '../lib/site.js';

interface Props {
  lang: 'fr' | 'en';
  title: string;
  description: string;
  path: string;            // chemin canonique, ex. « /fr/blog/ »
  altPath?: string | null; // page équivalente dans l'autre langue
  ogImage?: string;
  ogType?: string;
  withSchema?: boolean;    // JSON-LD (page d'accueil)
}
const { lang, title, description, path, altPath = null,
        ogImage = '/images/og-cabinet.jpg', ogType = 'website', withSchema = false } = Astro.props;
const canonical = SITE_URL + encodeURI(path);
const frPath = lang === 'fr' ? path : altPath;
const enPath = lang === 'en' ? path : altPath;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Marie Nussbaum',
  description: lang === 'fr'
    ? 'Psychologue clinicienne et psychanalyste à Paris 7ᵉ. Consultations en français et en anglais, au cabinet ou en visioconférence.'
    : 'Clinical psychologist and psychoanalyst in Paris 7th. Sessions in English and French, in person or online.',
  url: SITE_URL + '/',
  image: SITE_URL + '/images/photo-marie.jpg',
  address: { '@type': 'PostalAddress', streetAddress: '26 boulevard Raspail',
             postalCode: '75007', addressLocality: 'Paris', addressCountry: 'FR' },
  areaServed: 'Paris',
  knowsLanguage: ['fr', 'en'],
  priceRange: '120€ - 150€',
  sameAs: [LINKEDIN, DOCTOLIB],
};
---
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {frPath && <link rel="alternate" hreflang="fr" href={SITE_URL + encodeURI(frPath)} />}
  {enPath && <link rel="alternate" hreflang="en" href={SITE_URL + encodeURI(enPath)} />}
  {frPath && <link rel="alternate" hreflang="x-default" href={SITE_URL + encodeURI(frPath)} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={SITE_URL + ogImage} />
  <meta property="og:site_name" content="Marie Nussbaum" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  {withSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <!-- Mesure d'audience sans cookie : décommenter et renseigner le token une fois
       le site derrière Cloudflare Web Analytics.
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "TOKEN_A_RENSEIGNER"}'></script> -->
</head>
<body>
  <Header lang={lang} altPath={altPath} />
  <slot />
  <Footer lang={lang} />
  <script is:inline>
    // Coordonnées assemblées côté navigateur : intactes pour les visiteurs,
    // illisibles pour les robots qui moissonnent le HTML.
    document.querySelectorAll('[data-rev]').forEach(function (el) {
      var v = el.getAttribute('data-rev').split('').reverse().join('');
      el.textContent = v;
      if (el.hasAttribute('data-mail')) el.setAttribute('href', 'mailto:' + v);
      if (el.hasAttribute('data-tel')) el.setAttribute('href', 'tel:' + v.replace(/[^+\d]/g, ''));
    });
  </script>
</body>
</html>
