---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, DOCTOLIB, PHONE_REV, EMAIL_REV } from '../lib/site.js';
import frText from '../data/home.fr.json';
import enText from '../data/home.en.json';
import dims from '../lib/imagedims.json';

const { lang } = Astro.props as { lang: 'fr' | 'en' };
const posts = (await getCollection('blog', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const cards = featured.length === 3 ? featured : posts.slice(0, 3);
const count = (slug: string) => posts.filter((p) => p.data.categories.includes(slug)).length;

const t = lang === 'fr' ? frText : enText;
// Dimensions reelles des images, pour reserver la place avant chargement.
const dim = (src) => dims[src.split('/').pop()] ?? {};
const carnetsP = t.carnetsP.replace('{count}', String(posts.length));
---
<Base lang={lang} title={t.title} description={t.desc} path={`/${lang}/`} altPath={`/${lang === 'fr' ? 'en' : 'fr'}/`} withSchema>
  <div class="haut" style="margin-top:-1px">
    <div class="hero">
      <div>
        <span class="caps sur">{t.sur}</span>
        <h1>{t.h1}</h1>
        <p class="lead">{t.lead}</p>
        <div class="cta">
          <a class="btn" href={DOCTOLIB} target="_blank" rel="noopener">{t.rdv}</a>
          <a class="btn ligne" href="#approche">{t.decouvrir}</a>
        </div>
        <div class="assur">{t.assur.map((a) => <span>{a}</span>)}</div>
      </div>
      <figure class="medaillon">
        <img src={t.photo} alt={t.photoAlt} width={dim(t.photo).w} height={dim(t.photo).h} fetchpriority="high" />
        <figcaption>{t.pill}</figcaption>
      </figure>
    </div>
  </div>

  <section id="pourqui">
    <div class="wrap">
      <div class="sec-head">
        <span class="caps" style="color:var(--laiton-d)">{t.quiCaps}</span>
        <h2>{t.quiH2}</h2>
      </div>
      <div class="pourqui">
        {t.qui.map((q) => <div><h3>{q.titre}</h3><p>{q.texte}</p></div>)}
      </div>
    </div>
  </section>

  <div class="avant">
    <div class="wrap"><p set:html={t.avantHtml} /></div>
  </div>

  <section id="approche">
    <div class="wrap approche-grid">
      <div class="txt">
        <span class="caps" style="color:var(--laiton-d)">{t.apprCaps}</span>
        <h2 style="font-size:32px;margin:12px 0 20px">{t.apprH2}</h2>
        {t.appr.map((p) => <p set:html={p} />)}
      </div>
      <p class="exergue">{t.exergue}</p>
    </div>
  </section>

  <section class="visio" id="visio">
    <div class="wrap visio-grid">
      <img src={t.visioImage} alt={t.visioAlt} width={dim(t.visioImage).w} height={dim(t.visioImage).h} loading="lazy" />
      <div>
        <span class="caps" style="color:var(--laiton-d)">{t.visioCaps}</span>
        <h2>{t.visioH2}</h2>
        <p set:html={t.visioP} />
        <div class="points">{t.visioPts.map((p) => <span>{p}</span>)}</div>
      </div>
    </div>
  </section>

  <section id="cabinet">
    <div class="wrap cabinet-grid">
      <div>
        <span class="caps" style="color:var(--laiton-d)">{t.cabCaps}</span>
        <h2 style="margin-top:12px">{t.cabH2}</h2>
        <p style="color:var(--soft);margin-top:16px">{t.cabP}</p>
        <div class="fiche">
          <div><b>{t.adresse}</b>26 boulevard Raspail<br />75007 Paris</div>
          <div><b>{t.metro}</b>Sèvres-Babylone (10·12)<br />Rue du Bac (12)</div>
          <div><b>{t.langues}</b>Français · English<small>{t.languesNote}</small></div>
          <div><b>{t.hono}</b>120&nbsp;€ <small style="display:inline">· 150&nbsp;€ {t.honoEn}</small><small>{t.honoNote}</small></div>
        </div>
      </div>
      <img src={t.cabImage} alt={t.cabAlt} width={dim(t.cabImage).w} height={dim(t.cabImage).h} loading="lazy" />
    </div>
  </section>

  <section id="carnets" style="padding-top:20px">
    <div class="wrap">
      <div class="sec-head">
        <span class="caps" style="color:var(--laiton-d)">{t.carnetsCaps}</span>
        <h2>{t.carnetsH2}</h2>
        <p>{carnetsP}</p>
        <div class="chips">
          {CATEGORIES.map((c) => (
            <a href={`/${lang}/categories/${c[lang]}/`}>{lang === 'fr' ? c.nameFr : c.nameEn}<span>{count(c.fr) || count(c.en) || 0}</span></a>
          ))}
        </div>
      </div>
      <div class="posts">
        {cards.map((p) => <PostCard post={p} lang={lang} />)}
      </div>
      <p style="margin-top:36px"><a class="btn ligne" href={`/${lang}/blog/`}>{t.tous} →</a></p>
    </div>
  </section>

  <section class="final">
    <div class="wrap final-grid">
      <div>
        <h2>{t.finalH2}</h2>
        <p>{t.finalP}</p>
        <a class="btn" href={DOCTOLIB} target="_blank" rel="noopener">{t.reserver}</a>
      </div>
      <div class="carte">
        <div><b>{t.tel}</b><a data-rev={PHONE_REV} data-tel href="#"></a></div>
        <div><b>E-mail</b><a data-rev={EMAIL_REV} data-mail href="#"></a></div>
        <div><b>{t.cab}</b><span>26 bd Raspail, Paris 7ᵉ</span></div>
        <div><b>{t.visioLbl}</b><span>{t.visioVal}</span></div>
      </div>
    </div>
  </section>
</Base>
