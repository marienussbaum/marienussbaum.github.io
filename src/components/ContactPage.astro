---
import Base from '../layouts/Base.astro';
import { DOCTOLIB, PHONE_REV, EMAIL_REV } from '../lib/site.js';
const { lang } = Astro.props;
import frText from '../data/contact.fr.json';
import enText from '../data/contact.en.json';
const t = lang === 'fr' ? frText : enText;
---
<Base lang={lang} title={t.title} description={t.desc} path={`/${lang}/contact/`}
      altPath={`/${lang === 'fr' ? 'en' : 'fr'}/contact/`}>
  <div class="page-head">
    <div class="wrap">
      <span class="caps">{t.caps}</span>
      <h1>{t.h1}</h1>
      <p class="intro">{t.intro}</p>
    </div>
  </div>
  <div class="wrap contact-cols">
    <div>
      <p style="color:#3A464F;max-width:56ch">{t.p2}</p>
      <p style="margin-top:26px"><a class="btn" href={DOCTOLIB} target="_blank" rel="noopener">{t.rdv}</a></p>
      <p class="note-urgence">{t.urgence}</p>
    </div>
    <div class="carte-page">
      <div><b>{t.tel}</b><a data-rev={PHONE_REV} data-tel href="#"></a></div>
      <div><b>E-mail</b><a data-rev={EMAIL_REV} data-mail href="#"></a></div>
      <div><b>{t.adr}</b><span>26 boulevard Raspail, 75007 Paris</span></div>
      <div><b>{t.metro}</b><span>{t.metroVal}</span></div>
      <div><b>{t.visio}</b><span>{t.visioVal}</span></div>
      <div><b>{t.hono}</b><span>{t.honoVal}</span></div>
    </div>
  </div>
</Base>
